Production rate=
	Desired production rate
	~	units/Week
	~		|

dic=
	4
	~	Week
	~	Desired inventory coverage
	|

Correction for inventory=
	(Desired inventory-Inventory)/tci
	~	units/Week
	~	The firm tries to correct discrepancies between desired and actual \
		inventory in eight weeks.
	|

Shipment rate=
	Order rate
	~	units/Week
	~		|

Inventory= INTEG (
	+Production rate-Shipment rate,
		4000)
	~	units
	~	The initial inventory is four weeks' worth of shipments (1,000 x 4 = 4,000)
	|

Desired inventory=
	Average order rate*dic
	~	units
	~	Desired inventory is four weeks' worth ('dic') of anticipated shipments.
	|

Average order rate=
	SMOOTH(Order rate,taor)
	~	units/Week
	~	The firm forecast shipments by averaging past orders over an eight-week \
		period as a way of smoothing out any noise or lumpiness in demand.
	|

Order rate=
	1000*(1+step(0.1,10))
	~	units/Week
	~	In this model customer orders will equal a constant Order Rate (of 1,000 \
		units/week) until period 10, when orders step up by 10%, and then remain \
		at the higher rate.
	|

Desired production rate=
	Average order rate+Correction for inventory
	~	units/Week
	~	Desired production is determined by anticipated shipments, modified by a \
		correction to maintain inventory at the desired level.
	|

tci=
	8
	~	Week
	~	Time to correct Inventory
	|

taor=
	8
	~	Week
	~	Time to average order rate
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Paramaters
	|

FINAL TIME  = 100
	~	Week
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Week
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Week
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Week
	~	The time step for the simulation.
	|

