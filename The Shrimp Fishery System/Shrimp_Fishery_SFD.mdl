{UTF-8}
fleet adjustment=Fleet*net changes in the fleet
	~	boat/Year
	~		|

costs=Fleet*cost per boat
	~	$/Year
	~		|

catch capacity=Fleet*boat efficiency
	~	Tons/Year
	~		|

Fleet= INTEG (fleet adjustment,
		50)
	~	boat
	~		|

net changes in the fleet=IF THEN ELSE (margin>0.2, percentage change*margin, -percentage change\
		*ABS(margin))
	~	1/Year
	~		|

catch=catch capacity*(Shrimp Population/highest population)*RANDOM NORMAL(0.8,1.2,1,0.1\
		,5)
	~	Tons/Year
	~	Captures are based in the Captures Capacity, and also in the Population of shrimps \
		related to the highest possible value. We add a random component to \
		simulate occasional changes.
		
		catch capacity*(Shrimp Population/highest population)*RANDOM \
		NORMAL(0.8,1.2,1,0.1,5)
	|

boat efficiency=60+RAMP(3,2000,2100)
	~	Tons/boat/Year
	~	initial value  3,000 Tons captured / 50 boats =  60 Tons/boat. We include the \
		efficiency increase based on the aspects described in the text. 
		
		It means boat efficiency starts at 60 tons per boat in 1950 and increases linearly \
		by 3 tons per year until 2050, reaching 360 tons/boat — representing \
		technological progress in the fleet.
		
		boat efficiency = 60+RAMP(3,1950,2050)
	|

earnings=catch*price per ton
	~	$/Year
	~		|

price per ton=2000
	~	$/Tons
	~	million of $ per Ton of shrimp
		
		0.02
	|

percentage change=0.05
	~	1/Year
	~	% of annual variation in the number of boats in base to the margin.
		
		0.05
	|

cost per boat=1e+06
	~	$/boat/Year
	~	milion $ per Year per boat. Cost of amortization and maintenance of the \
		boat every year
	|

margin=
	(earnings-costs)/costs
	~	Dmnl
	~		|

highest population=
	37500
	~	Tons
	~		|

population increase=
	"% of biomass increment"*Shrimp Population*(1-(Shrimp Population/highest population)\
		)
	~	Tons/Year
	~		|

"% of biomass increment"=0.5
	~	1/Year
	~	0.5
	|

Shrimp Population= INTEG (
	population increase-catch,
		30000)
	~	Tons
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2100
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 2000
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0625
	~	Year [0,?]
	~	The time step for the simulation.
	|

\\\---/// Sketch information - do not modify anything except names
