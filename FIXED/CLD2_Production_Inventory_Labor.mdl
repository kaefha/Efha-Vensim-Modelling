{UTF-8}
ade = 50
	~ Week
	~ |

Average labor productivity = 20
	~ units/person/Week
	~ |

Average order rate = SMOOTH(Order rate, taor)
	~ units/Week
	~ |

Correction for inventory = (Desired inventory - Inventory) / tci
	~ units/Week
	~ |

Correction for labor = (Desired labor - Labor) / tcl
	~ person/Week
	~ |

Desired inventory = Average order rate * dic
	~ units
	~ |

Desired labor = Desired production rate / Average labor productivity
	~ person
	~ |

Desired production rate = Average order rate + Correction for inventory
	~ units/Week
	~ |

dic = 4
	~ Week
	~ |

FINAL TIME = 100
	~ Week
	~ |

Hiring rate = Quit rate + Correction for labor
	~ person/Week
	~ |

INITIAL TIME = 0
	~ Week
	~ |

Inventory = INTEG(Production rate - Shipment rate, 4000)
	~ units
	~ |

Labor = INTEG(Hiring rate - Quit rate, 50)
	~ person
	~ |

Normal production rate = Labor * Average labor productivity
	~ units/Week
	~ |

Order rate = 1000 * (1 + STEP(0.1, 10))
	~ units/Week
	~ |

Production rate = Normal production rate
	~ units/Week
	~ |

Quit rate = Labor / ade
	~ person/Week
	~ |

SAVEPER = 1
	~ Week
	~ |

Shipment rate = Order rate
	~ units/Week
	~ |

taor = 8
	~ Week
	~ |

tci = 8
	~ Week
	~ |

tcl = 24
	~ Week
	~ |

TIME STEP = 1
	~ Week
	~ |

